# ==============================================================================
# StudyTracker Environment Configuration (.env.example)
# Copy to .env and adjust variables as needed.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=studytracker
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=studypassword_change_me_in_prod
POSTGRES_PORT=5432

# Backend & Security Configuration
SERVER_PORT=8080
JWT_SECRET=supersecretjwtkeywithatleast256bitsofentropyforsecurity!
JWT_EXPIRATION_MS=86400000

# AI Assistant Configuration
# Options for AI_PROVIDER: MOCK (default, zero-cost), OPENAI, OLLAMA
AI_ENABLED=true
AI_PROVIDER=MOCK

# OpenAI-Compatible API (Only needed if AI_PROVIDER=OPENAI)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Configuration (Only needed if AI_PROVIDER=OLLAMA)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# CORS & Frontend Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
